!data/processed/.gitkeep
!data/external/.gitkeep
!data/artifacts/.gitkeep

# Model checkpoints and generated evaluation outputs
models/checkpoints/*
models/registry/*
models/baseline/*
models/cnn/*
models/lstm/*
models/bert/*
